<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Follow Up Kerjasama</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
</head>
<body>
  <main class="container">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-top:30px;">
      <h2>Riwayat Follow Up</h2>
      <a href="/auth/logout">Logout</a>
    </div>
    <div style="display: flex; gap: 10px;">
      <a href="/follow-up/create" role="button">+ Tambah Follow Up</a>
      <a href="/export/mou" role="button" class="secondary">Ekspor Data MoU (CSV)</a>
    </div>
    <table style="margin-top:20px;">
      <thead>
        <tr><th>No</th><th>Instansi</th><th>Catatan</th><th>Tanggal</th><th>Aksi</th></tr>
      </thead>
      <tbody>
        <% if (followUps.length === 0) { %>
          <tr><td colspan="5" style="text-align:center;">Belum ada data</td></tr>
        <% } %>
        <% followUps.forEach((f, i) => { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= f.nama_instansi %></td>
          <td><%= f.catatan %></td>
          <td><%= f.tanggal %></td>
          <td>
            <form action="/follow-up/delete/<%= f.id %>" method="POST" style="display:inline;">
              <button type="submit" onclick="return confirm('Hapus?')" style="background:none;border:none;color:red;cursor:pointer;">Hapus</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </main>
</body>
</html>